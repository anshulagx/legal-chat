# Server only. Copy to .env for local development.
# For hosted deployment, add the production values to Render's Environment settings.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
PORT=3000

# Use a distinct, randomly generated secret and seed password in each environment.
JWT_SECRET=
JWT_ISSUER=legal-support-chat
JWT_AUDIENCE=legal-support-chat-browser
JWT_TTL_SECONDS=900
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=

# Use a scoped database user for each environment. Quote the URI and percent-encode
# reserved characters in the URI's username or password.
MONGODB_URI=
MONGODB_DB_NAME=legal_chat_dev

# Use a private, versioned bucket. Use separate buckets or isolated prefixes.
# For temporary AWS credentials, supply the session token too.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=
S3_KEY_PREFIX=legal-chat/dev/

# The chat model is a preflight candidate. Wave 05 pins the final model.
# Embeddings use the same OpenRouter key.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536
# Phase 04: set true to process pinned uploads and bootstrap shared knowledge.
# Omit/false keeps indexing disabled for earlier-phase isolated fixtures.
INDEXING_ENABLED=false
# Optional hosted QA only (NODE_ENV=test): qa04_<8-to-40 lowercase letters/digits>_.
# Leave unset for normal development/production.
# MONGODB_COLLECTION_PREFIX=

# Copy the project-specific host and keys from Langfuse Cloud.
# Keep customer content out of telemetry by default.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TRACE_CONTENT=false

# Initial application limits from the TRD. Windows are in seconds.
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=900
CHAT_GENERATION_LIMIT=10
CHAT_GENERATION_WINDOW_SECONDS=600
UPLOAD_RESERVATION_LIMIT=10
UPLOAD_RESERVATION_WINDOW_SECONDS=600
