{
  "name": "legal-support-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "dev": "npm run build:client && node --env-file=.env --experimental-strip-types --watch server/src/index.ts",
    "build": "npm run build:client && tsc -p server/tsconfig.json",
    "build:client": "tsc -p client/tsconfig.json && vite build client",
    "start": "node server/dist/index.js",
    "test:phase01": "node --test scripts/phase01.test.mjs",
    "test:wave-02": "node --test scripts/phase02.test.mjs",
    "test:wave-03": "node --test scripts/phase03.test.mjs",
    "test:wave-04": "node --test scripts/phase04.test.mjs",
    "bootstrap": "node --env-file=.env scripts/bootstrap.mjs",
    "test:wave-05": "node --test scripts/phase05.test.mjs scripts/client-stream.test.mjs scripts/grounding.test.mjs",
    "test:wave-06": "node --test scripts/phase06.test.mjs",
    "test:wave-07": "node --test scripts/phase07.test.mjs scripts/phase07-telemetry.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "mongodb": "^6.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-presigned-post": "^3.0.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "js-tiktoken": "^1.0.21",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
